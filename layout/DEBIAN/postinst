#!/bin/sh
chown root:wheel /var/jb/usr/bin/jbevasion
chmod 6755 /var/jb/usr/bin/jbevasion

# Remove old PreferenceLoader entry if it exists
rm -f /var/jb/Library/PreferenceLoader/Preferences/jbevasion.plist

# Remove old tweak if it exists
rm -f /var/jb/Library/MobileSubstrate/DynamicLibraries/jbevasiontweak.dylib
rm -f /var/jb/Library/MobileSubstrate/DynamicLibraries/jbevasiontweak.plist

# Remove old preference bundle if it exists
rm -rf /var/jb/Library/PreferenceBundles/jbevasionprefs.bundle

# Remove old Control Center module bundle (replaced by overlay button tweak)
rm -rf /var/jb/Library/ControlCenter/Bundles/jbevasioncc.bundle

# Remove old CCSupport hook tweak (replaced by jbevasionCC overlay tweak)
rm -f /var/jb/Library/MobileSubstrate/DynamicLibraries/jbevasionccsupport.dylib
rm -f /var/jb/Library/MobileSubstrate/DynamicLibraries/jbevasionccsupport.plist

echo "jbevasion: installed. Respring to load the Control Center overlay button."
echo "Pull down Control Center - toggle appears at top-left."